# Copy to .env and fill in. Never commit .env.
# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Public origin(s) behind the Cloudflare Worker/VPC path (CSRF + redirects)
CSRF_TRUSTED_ORIGINS=https://your-worker-subdomain.workers.dev

# PostgreSQL (authoritative application database)
POSTGRES_DB=ctf
POSTGRES_USER=ctf
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Discord OAuth (create at https://discord.com/developers/applications)
# Redirect URL for allauth: http://<host>/accounts/discord/login/callback/
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Guacamole signed-JSON auth: 128-bit hex secret (32 hex chars), shared with
# the guacamole container's JSON_SECRET_KEY.
# Generate: python3 -c "import secrets; print(secrets.token_hex(16))"
GUACAMOLE_JSON_SECRET=
GUACAMOLE_DB_PASSWORD=

# Backups (backup/BACKUPS.md). Owner policy: local-only destination for
# now, daily run, 14-day retention, log-file alerting.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Space-separated SSH targets (aliases from ~/.ssh/config or user@host) of
# the workhorses whose pinned templates get rsynced into the backup tree.
# Empty = template sync skipped with a loud warning.
WORKHORSE_SSH_TARGETS=
WORKHORSE_IMAGES_DIR=/var/lib/libvirt/images/ctf/images
# Reserved for the future off-machine copy (owner deferred the decision);
# when set, the whole backup tree is mirrored there with rsync -a --delete.
BACKUP_REMOTE_DEST=

# REQUIRED. Address of the guacd that terminates desktop sessions — the
# per-workhorse guacd (agent/guacd-install.sh) on the machine hosting the
# lab VMs. Guacamole 1.6.0 has no per-connection guacd routing, so this is
# deployment-wide; the guacd's VNC hop reaches guests over that host's
# loopback. See the workhorse runbook (agent/ADD-A-WORKHORSE.md §8).
GUACD_HOSTNAME=

# Path A multi-workhorse desktop routing (leave EMPTY for a single
# workhorse: every host's desktops are then served at /guacamole/).
# Comma-separated "host-slug=/web/path/" pairs, one per Guacamole instance;
# each instance is a compose service pinned to that workhorse's guacd with
# WEBAPP_CONTEXT matching the path. See agent/ADD-A-WORKHORSE.md.
# Example: GUACAMOLE_INSTANCE_PATHS=workhorse-02=/guacamole/,workhorse-03=/guacamole/workhorse-03/
GUACAMOLE_INSTANCE_PATHS=
