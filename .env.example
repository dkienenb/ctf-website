# Copy to .env and fill in. Never commit .env.
# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (authoritative application database)
POSTGRES_DB=ctf
POSTGRES_USER=ctf
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Discord OAuth (create at https://discord.com/developers/applications)
# Redirect URL for allauth: http://<host>/accounts/discord/login/callback/
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Guacamole signed-JSON auth: 128-bit hex secret (32 hex chars), shared with
# the guacamole container's JSON_SECRET_KEY.
# Generate: python3 -c "import secrets; print(secrets.token_hex(16))"
GUACAMOLE_JSON_SECRET=
GUACAMOLE_DB_PASSWORD=

# Owner decisions recorded 2026-11-14 (docs/DECISIONS.md in ctf-prototype)
# SUBMISSION_COOLDOWN_SECONDS=10
GUACAMOLE_VNC_HOST=host.docker.internal
